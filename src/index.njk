---
  title: Will Martin — Design Engineer
  layout: base.njk
---

<main id="main">

  <h1 class="rise rise-1">
    <a href="{{ '/' | url }}" class="wordmark wordmark-lg"><span class="scheme">w://</span>martian</a>
  </h1>

  <p class="rise rise-2">
    I'm a software engineer and designer in Atlanta. I work on design systems,
    and I write here about UI, open source, and how we build for the web.
  </p>

  <p class="rise rise-3 mb-16">
    <a href="/about/">more about me →</a>
  </p>

  <section class="rise rise-4">
    <div class="entry-list">
      {% for post in collections.posts | reverse %}
        <article class="entry">
          <time class="entry-date" datetime="{{ post.date | isoDate }}">{{ post.date | revDate }}</time>
          <a href="{{ post.url }}" class="entry-title">{{ post.data.title }}</a>
          {% if post.data.blurb %}
            <p class="entry-blurb">{{ post.data.blurb }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>

</main>
