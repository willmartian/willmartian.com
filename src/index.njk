---
  title: Will Martin — Design Engineer
  layout: base.njk
---

<main id="main">

  <h1 class="rise rise-1">
    <a href="{{ '/' | url }}" class="wordmark wordmark-lg"><span class="scheme">w://</span>martian</a>
  </h1>

  <p class="rise rise-2">
    I'm a software engineer, designer, and writer based in Atlanta. Below are thoughts and poems on life, technology, etc.
  </p>

  <p class="rise rise-3 home-lede-end">
    <a href="/about/">more about me →</a>
  </p>

  <section class="rise rise-4">
    <div class="entry-list">
      {% for item in collections.writing | reverse %}
        <article class="entry">
          <time class="entry-date" datetime="{{ item.date | isoDate }}">{{ item.date | revDate }}</time>
          <a href="{{ item.url }}" class="entry-title">{{ item.data.title }}</a>
          {% if "poems" in item.data.tags %}
            <span class="entry-tag entry-tag-poem annotate">poem</span>
          {% else %}
            <span class="entry-tag entry-tag-blog annotate">blog</span>
          {% endif %}
          {% if item.data.blurb %}
            <p class="entry-blurb">{{ item.data.blurb }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>

</main>
