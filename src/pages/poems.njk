---
title: Poems
layout: base.njk
---

<main id="main">
  <h1 class="rise rise-1">Poems</h1>

  <section class="rise rise-2">
    <div class="entry-list">
      {% for poem in collections.poems | reverse %}
        <article class="entry">
          <time class="entry-date" datetime="{{ poem.date | isoDate }}">{{ poem.date | revDate }}</time>
          <a href="{{ poem.url }}" class="entry-title">{{ poem.data.title }}</a>
          {% if poem.data.blurb %}
            <p class="entry-blurb">{{ poem.data.blurb }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
</main>
