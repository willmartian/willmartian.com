{# On the homepage the hero carries the wordmark, so the masthead leaves it
   out rather than printing the name twice. #}
<header class="masthead">
  {% if page.url != '/' %}
    <a href="{{ '/' | url }}" class="wordmark wordmark-sm"><span class="scheme">w://</span>martian</a>
  {% endif %}

  <nav class="nav-links" aria-label="Main">
    <a href="{{ '/' | url }}" class="nav-link {% if page.url == '/' %}active{% endif %}">Writing</a>
    <a href="{{ '/poems/' | url }}" class="nav-link {% if page.url == '/poems/' %}active{% endif %}">Poems</a>
    <a href="{{ '/about/' | url }}" class="nav-link {% if page.url == '/about/' %}active{% endif %}">About</a>
    {# Both icons ship in the markup and CSS picks which one shows, so the
       right glyph is correct at first paint even before the script runs.
       The icon shows the theme you'd switch *to*, matching the aria-label. #}
    <button type="button" class="theme-toggle" data-theme-toggle
            aria-label="Switch color theme">
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.5"/>
        <path d="M12 1.5v2M12 20.5v2M3.6 3.6l1.4 1.4M19 19l1.4 1.4M1.5 12h2M20.5 12h2M3.6 20.4L5 19M19 5l1.4-1.4"/>
      </svg>
    </button>
  </nav>
</header>
